# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
next-env.d.ts
# Next 16 writes this on every `next dev`, and re-creates it if it is removed.
# It is Next's own boilerplate rather than project content, and it regenerates
# for anyone who boots the app, so tracking it would only add churn.
apps/web/AGENTS.md

# Build output
dist/
build/
*.tsbuildinfo

# Environment. Only the example file is ever committed.
.env
.env.local
.env.*.local
# A backup of `.env` carries the same secrets as `.env` itself. One was made on
# 2026-10-27 before the Sheets variables were written and it was untracked but
# not ignored, which is one `git add -A` away from publishing the webhook token.
.env.bak-*
!.env.example

