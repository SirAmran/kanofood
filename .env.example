# KanoFood environment variables.
#
# Names only. Values are never committed. Copy this file to .env and fill it in.
# .env is gitignored from the first commit.
#
# Money values in this system are integer kobo, never floats. See docs/ARCHITECTURE.md section 5.1.

# --- Database -----------------------------------------------------------------
# Pooled connection string. Required by the app at runtime.
DATABASE_URL=
# Unpooled connection string. Required by Prisma for migrations only.
DIRECT_URL=

# --- Auth ---------------------------------------------------------------------
AUTH_JWT_SECRET=
# Access token lifetime. Minutes, not hours. Example: 15m
AUTH_TOKEN_TTL=
# Signing key for guest order tokens. Rotating this invalidates every live tracking link.
ORDER_TOKEN_SECRET=

# --- Brand --------------------------------------------------------------------
# Undecided. Everything on screen reads from these, so a rebrand is a settings change.
BRAND_NAME=
BRAND_TAGLINE=
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_COLOR_PRIMARY=
BRAND_COLOR_ACCENT=

# --- Delivery -----------------------------------------------------------------
# Slug of the delivery zone used when none can be resolved from the customer location.
DELIVERY_DEFAULT_ZONE=

# --- Email --------------------------------------------------------------------
EMAIL_PROVIDER_KEY=
EMAIL_FROM=

# --- Web push -----------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# --- Object storage (kitchen and food images) ---------------------------------
# Provider undecided. Netlify Blobs is the natural fit given the deployment stack.
STORAGE_PROVIDER=
STORAGE_KEY=
STORAGE_SECRET=

# --- Google Sheets (reporting only, never the database) -----------------------
SHEETS_SYNC_ENABLED=false
SHEETS_SYNC_TARGET_ID=
