# KanoFood environment variables.
#
# Names only. Values are never committed. Copy this file to .env and fill it in.
# .env is gitignored from the first commit.
#
# Money values in this system are integer kobo, never floats. See docs/ARCHITECTURE.md section 5.1.

# --- Database -----------------------------------------------------------------
# Pooled connection string. Required by the app at runtime.
DATABASE_URL=
# Unpooled connection string. Required by Prisma for migrations only.
DIRECT_URL=

# --- Auth ---------------------------------------------------------------------
AUTH_JWT_SECRET=
# Access token lifetime. Minutes, not hours. Example: 15m
AUTH_TOKEN_TTL=
# Access token lifetime for an admin, which is shorter on purpose. UX_SPEC
# section 7.1: admin sessions are the most protected of the four roles. The
# refresh token still lasts its full thirty days, so this is a background token
# exchange, not a second sign-in. Example: 5m
ADMIN_TOKEN_TTL=
# Signing key for guest order tokens. Rotating this invalidates every live tracking link.
ORDER_TOKEN_SECRET=

# --- Brand --------------------------------------------------------------------
# Undecided. Everything on screen reads from these, so a rebrand is a settings change.
BRAND_NAME=
BRAND_TAGLINE=
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_COLOR_PRIMARY=
BRAND_COLOR_ACCENT=

# --- Delivery -----------------------------------------------------------------
# Slug of the delivery zone used when none can be resolved from the customer location.
DELIVERY_DEFAULT_ZONE=

# --- Support contact ----------------------------------------------------------
# The number the storefront prints. Shown on help, on checkout, on tracking and
# when a customer's point is outside every zone. Optional: left blank, every one
# of those lines is hidden rather than broken. Confirmation is a phone call at
# launch, so this is a number a customer must be able to reach.
#
# Both of these are now settable at runtime on the admin settings screen, which
# writes platform_settings. The environment is the fallback and wins only while
# that row is empty, so a host that configures a number here still works and an
# operator can change it without a deploy.
PLATFORM_PHONE=
# A second channel, for customers who would rather type than talk.
PLATFORM_WHATSAPP=

# --- Email (Resend) ------------------------------------------------------------
# The API key from Resend, not from a generic provider. EMAIL_FROM must be an
# address on a domain verified in Resend. Left empty, every email is recorded as
# skipped with the reason and nothing else changes. Email is internal only:
# admin, kitchen and rider. Customers are never mailed.
EMAIL_PROVIDER_KEY=
EMAIL_FROM=

# --- Web push -----------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
# Left empty, push is recorded as skipped. The subject is the contact a push
# service can use if this sender misbehaves: a mailto: or https: value.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# --- Object storage (kitchen and food images) ---------------------------------
# Supabase Storage, decided 2026-10-08. One public `media` bucket: menu and
# kitchen images are anonymous storefront content, so signed URLs would add an
# expiring link per image per page load and hide nothing.
#   STORAGE_PROVIDER  supabase
#   STORAGE_KEY       the project URL
#   STORAGE_SECRET    the service_role key. Server side only, never shipped to a
#                     browser, and never given write access to storage.objects.
STORAGE_PROVIDER=
STORAGE_KEY=
STORAGE_SECRET=

# --- Google Sheets (reporting only, never the database) -----------------------
# Writes go to a Google Apps Script web app (docs/sheets/code.gs) over HTTPS, not
# to the Sheets API, so there is no OAuth scope to grant. Deploy the script as a
# web app, then put its /exec URL and its shared secret here. Off unless the flag
# is exactly true.
SHEETS_SYNC_ENABLED=false
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=
